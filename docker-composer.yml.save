version: '3.8'

services:
  php:
    image: php:8.2-fpm
    volumes:
      - .:/var/www
    working_dir: /var/www
    networks:
      - lab_network

  nginx:
    image: nginx:alpine
    ports:
      - "8085:80"
    volumes:
      - .:/var/www
      - ./docker/nginx.conf:/etc/nginx/conf.d/default.conf
    depends_on:
      - php
    networks:
      - lab_network

  postgres:
    image: postgres:15-alpine
    ports:
      - "5435:5432"
    environment:
      POSTGRES_DB: lab_db
      POSTGRES_USER: lab_user
      POSTGRES_PASSWORD: lab_password
    volumes:
      - pgdata:/var/lib/postgresql/data
    networks:
      - lab_network

networks:
  lab_network:
    driver: bridge

volumes:
  pgdata:

